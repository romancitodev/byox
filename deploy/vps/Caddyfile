# /etc/caddy/Caddyfile en la VPS. Caddy pide y renueva los certificados solo.
# byox.dev (la raíz) queda libre para la landing en Vercel; la app y Forgejo van en subdominios.
#
# Los puertos 3333 y 3000 de compose están atados a 127.0.0.1: este proxy es la única entrada.

{
	# email tu@correo.com   # opcional: avisos de Let's Encrypt si un certificado no se renueva
}

app.byox.dev {
	encode zstd gzip
	# El endpoint /mcp puede responder en streaming: sin buffer.
	reverse_proxy 127.0.0.1:3333 {
		flush_interval -1
	}
}

git.byox.dev {
	# Pushes grandes de repos de cursos.
	request_body {
		max_size 512MB
	}
	reverse_proxy 127.0.0.1:3000
}

# Copiar a /home/deploy/byox/.env ANTES de correr ./setup.sh.
# setup.sh respeta estas claves y agrega las que genera (usuario, tokens, contraseñas de Postgres).

# Postgres en vez de SQLite + JSON (docker-compose.cloud.yml).
COMPOSE_FILE=docker-compose.yml:docker-compose.cloud.yml

# Forgejo (clonar/push) y la app, detrás de Caddy con HTTPS.
BYOX_PUBLIC_URL=https://git.byox.dev
BYOX_DOMAIN=git.byox.dev
BYOX_WEB_URL=https://app.byox.dev
BYOX_TRUST_PROXY=1
BYOX_SECURE_COOKIES=1
# app.byox.dev es sólo la app: se sirve en la raíz (app.byox.dev/cursos) y no en /app.
BYOX_APP_ROOT=1

# Cuentas: closed al principio. Cuando pruebes todo, invite (con código) para sumar gente.
BYOX_SIGNUP=closed
BYOX_AUTHORS=admin

# Avisos a Discord (Ajustes del servidor → Integraciones → Webhooks). Es un secreto: no lo pegues en chats ni en git.
#   DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
#   DISCORD_PING_USER=<tu id de usuario de Discord: te menciona sólo en los errores>
#   DISCORD_EVENTS=all     # por defecto no avisa cuando alguien empieza un curso

# Para que el botón "Empezar" de la landing en Vercel apunte a esta app (se usa al construir la landing):
#   PUBLIC_APP_URL=https://app.byox.dev
